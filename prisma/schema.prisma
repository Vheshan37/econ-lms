generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ResourceType {
  VIDEO
  PDF
  PAST_PAPER
  QUIZ
}


model AcademicYear {
  id          String      @id @default(uuid())
  year        String      // e.g., "2025 A/L"
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  classTypes  ClassType[]
}

model ClassType {
  id        String        @id @default(uuid())
  name      String        // Custom names allowed
  yearId    String
  year      AcademicYear  @relation(fields: [yearId], references: [id], onDelete: Cascade)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  topics    Topic[]
  studentAssignments StudentClassType[]

  @@index([yearId])
}

model Topic {
  id          String      @id @default(uuid())
  title       String
  description String?
  order       Int         @default(0)
  classTypeId String
  classType   ClassType   @relation(fields: [classTypeId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  isActive    Boolean     @default(true)
  resources   Resource[]

  @@index([classTypeId])
}

model Resource {
  id          String       @id @default(uuid())
  title       String
  type        ResourceType
  url         String
  description String?
  topicId     String?
  topic       Topic?       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([topicId])
}

model FreeResource {
  id          String       @id @default(uuid())
  title       String
  type        ResourceType
  url         String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Student {
  id              String              @id @default(uuid())
  // Personal Information
  name            String
  school          String
  dateOfBirth     DateTime
  
  // Account
  email           String              @unique
  
  // Status
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  // Relations
  classAssignments StudentClassType[]
}

model StudentClassType {
  id          String      @id @default(uuid())
  studentId   String
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classTypeId String
  classType   ClassType   @relation(fields: [classTypeId], references: [id], onDelete: Cascade)
  assignedAt  DateTime    @default(now())
  
  @@unique([studentId, classTypeId])
  @@index([studentId])
  @@index([classTypeId])
}

model HallOfFame {
  id            String   @id @default(uuid())
  name          String
  district      String
  academicYear  String   // e.g. "2022 A/L"
  islandRank    Int?     // Nullable for cases where student didn't get island rank
  districtRank  Int?     // Nullable for cases where student didn't get district rank
  imageUrl      String?  // URL to student image
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Institute {
  id         String      @id @default(uuid())
  name       String
  location   String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  timetables Timetable[]
}

model Timetable {
  id           String    @id @default(uuid())
  instituteId  String
  institute    Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  day          String    // Monday, Tuesday, etc.
  startTime    String    // e.g. "09:00"
  endTime      String    // e.g. "11:00"
  academicYear String    // e.g. "2025 A/L"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([instituteId])
}

model Teacher {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OTP {
  id         String   @id @default(uuid())
  email      String
  code       String   // 6-digit OTP
  userType   String   // 'student' or 'teacher'
  expiresAt  DateTime
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([email, userType])
  @@index([expiresAt])
}

model LandingPageContent {
  id          String   @id @default(uuid())
  section     String   @unique // "hero", "about", "contact"
  content     Json     // Flexible JSON storage
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String
  content   String   @db.Text
  imageUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ModernFeature {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String   // Lucide icon name
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
